generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  EXPIRED
  CANCELLED
}

enum TransactionStatus {
  INITIATED
  SUCCESSFUL
  FAILED
  EXPIRED
  CANCELLED
  REVERSED
  TIMEOUT
  PENDING
}

enum PaymentMethod {
  CASH
  MOBILE_APP
  USSD
  WEB
  ATM
  WALLET
  BANK_TRANSFER
  CARD
}

enum UserRole {
  SYSTEM_ADMIN
  BILLER_USER
  AGENT_USER
  SUPER_ADMIN
  BILLER_ADMIN
}

// --- MODELS ---

model UserSettings {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // UI Preferences
  theme    String @default("light") // light, dark, system
  language String @default("en")

  emailNotifications Boolean @default(true)
  smsNotifications   Boolean @default(false)

  //Security Settings 
  twoFactorEnabled Boolean @default(false)
  loginAlerts      Boolean @default(true)

  updatedAt DateTime @updatedAt
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         UserRole  @default(AGENT_USER)
  status       String    @default("active")
  isActive     Boolean   @default(true)
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?

  // Relations - Unified naming
  billerId String?
  biller   Biller? @relation(fields: [billerId], references: [id], onDelete: Cascade)
  agentId  String?
  agent    Agent?  @relation(fields: [agentId], references: [id])

  agentEvents        AgentEvent[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  mustChangePassword Boolean        @default(true)
  resetToken         String?        @unique
  resetTokenExpires  DateTime?
  settings           UserSettings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  billerId  String?
  title     String
  message   String
  type      String // e.g., "BILL_UPLOADED", "SYSTEM_ALERT"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  biller Biller? @relation(fields: [billerId], references: [id])
}

model Biller {
  id             String    @id @default(uuid())
  name           String
  code           String    @unique // e.g., "EEU"
  category       String
  allowsPartial  Boolean   @default(false)
  chargesLateFee Boolean   @default(true) // Her field
  gracePeriod    Int       @default(0) // Her field
  accountNo      String? // Her field for reconciliation
  apiEndPoint    String?
  isActive       Boolean   @default(true)
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?

  users         User[]
  bills         Bill[]
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([code])
}

model Customer {
  id        String   @id @default(uuid())
  fullName  String   @db.VarChar(100)
  email     String?  @unique
  phoneNo   String   @unique @db.VarChar(15)
  isActive  Boolean  @default(true)
  bills     Bill[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phoneNo])
}

model Agent {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  apiKey    String?   @unique // Her field for security
  isEnabled Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  users        User[]
  transactions Transaction[]
  events       AgentEvent[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([code])
}

model Bill {
  id               String     @id @default(uuid())
  billReference    String
  customerName     String?
  amount           Decimal    @db.Decimal(12, 2)
  amountPaid       Decimal    @default(0.00) @db.Decimal(12, 2)
  remainingBalance Decimal    @default(0.00) @db.Decimal(12, 2)
  currency         String     @default("ETB")
  dueDate          DateTime
  paidAt           DateTime? // Her field
  status           BillStatus @default(UNPAID)
  isDeleted        Boolean    @default(false)
  deletedAt        DateTime?
  period           String // e.g., "2023-10"

  billerId   String
  biller     Biller    @relation(fields: [billerId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  transactions   Transaction[]
  phoneNumber    String?
  additionalInfo Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([billReference, period, billerId])
  @@index([billReference])
}

model Transaction {
  id              String  @id @default(uuid())
  transactionId   String  @unique
  agentReference  String? @unique
  billerReference String? @unique
  derashRef       String  @unique @default(cuid()) // Her internal ref

  amount          Decimal @db.Decimal(12, 2)
  billerShare     Decimal @default(0.00) @db.Decimal(12, 2) // Fee splitting
  agentShare      Decimal @default(0.00) @db.Decimal(12, 2)
  aggregatorShare Decimal @default(0.00) @db.Decimal(12, 2)
  totalAmount     Decimal @db.Decimal(12, 2)

  status         TransactionStatus @default(INITIATED)
  paymentMethod  PaymentMethod     @default(MOBILE_APP)
  idempotencyKey String            @unique

  billId  String
  bill    Bill   @relation(fields: [billId], references: [id])
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  payerPhone  String?
  rawResponse Json? // Her field for debugging

  settledWithAgent  Boolean @default(false)
  settledWithBiller Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionId])
  @@index([idempotencyKey])
}

model AgentEvent {
  id        String   @id @default(uuid())
  agentId   String?
  agent     Agent?   @relation(fields: [agentId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  payload   Json? // Her naming
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  action     String
  entityName String
  entityId   String
  status     String   @default("SUCCESS")
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entityName, entityId])
  @@index([userId])
}

model RefreshToken {
  id     String @id @default(uuid())
  token  String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  //  Metadata Fields for Security
  userAgent String? // Stores browser/device info
  ipAddress String? // Stores the login location IP

  expiresAt DateTime
  createdAt DateTime @default(now())
}
