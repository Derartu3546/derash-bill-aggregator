generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  passwordHash       String
  fullName           String
  role               UserRole       @default(AGENT_USER)
  billerId           String?
  agentId            String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  mustChangePassword Boolean        @default(true)
  status             String         @default("active")
  deletedAt          DateTime?
  isDeleted          Boolean        @default(false)
  resetToken         String?        @unique
  resetTokenExpires  DateTime?
  isActive           Boolean        @default(true)
  agentEvents        AgentEvent[]
  auditLogs          AuditLog[]
  refreshTokens      RefreshToken[]
  agent              Agent?         @relation(fields: [agentId], references: [id])
  biller             Biller?        @relation(fields: [billerId], references: [id], onDelete: Cascade)

  @@index([email])
}

model Biller {
  id             String    @id @default(uuid())
  name           String
  code           String    @unique
  category       String
  allowsPartial  Boolean   @default(false)
  apiEndPoint    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  isDeleted      Boolean   @default(false)
  accountNo      String?
  chargesLateFee Boolean   @default(true)
  gracePeriod    Int       @default(0)
  bills          Bill[]
  users          User[]

  @@index([code])
}

model Customer {
  id        String   @id @default(uuid())
  fullName  String   @db.VarChar(100)
  email     String?  @unique
  phoneNo   String   @unique @db.VarChar(15)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bills     Bill[]

  @@index([phoneNo])
}

model Agent {
  id           String        @id @default(uuid())
  name         String
  code         String        @unique
  isEnabled    Boolean       @default(true)
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?
  isDeleted    Boolean       @default(false)
  apiKey       String?       @unique
  updatedAt    DateTime      @updatedAt
  events       AgentEvent[]
  transactions Transaction[]
  users        User[]

  @@index([code])
}

model Bill {
  id               String        @id @default(uuid())
  billReference    String
  amount           Decimal       @db.Decimal(12, 2)
  amountPaid       Decimal       @default(0.00) @db.Decimal(12, 2)
  currency         String        @default("ETB")
  dueDate          DateTime
  status           BillStatus    @default(UNPAID)
  period           String
  billerId         String
  phoneNumber      String?
  additionalInfo   Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  isDeleted        Boolean       @default(false)
  customerName     String?
  customerId       String?
  paidAt           DateTime?
  remainingBalance Decimal       @default(0.00) @db.Decimal(12, 2)
  biller           Biller        @relation(fields: [billerId], references: [id], onDelete: Cascade)
  customer         Customer?     @relation(fields: [customerId], references: [id])
  transactions     Transaction[]

  @@unique([billReference, period, billerId])
  @@index([billReference])
}

model Transaction {
  id                String            @id @default(uuid())
  transactionId     String            @unique
  agentReference    String?           @unique
  billerReference   String?           @unique
  amount            Decimal           @db.Decimal(12, 2)
  totalAmount       Decimal           @db.Decimal(12, 2)
  status            TransactionStatus @default(INITIATED)
  paymentMethod     PaymentMethod     @default(MOBILE_APP)
  idempotencyKey    String            @unique
  billId            String
  agentId           String
  payerPhone        String?
  settledWithAgent  Boolean           @default(false)
  settledWithBiller Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  agentShare        Decimal           @default(0.00) @db.Decimal(12, 2)
  aggregatorShare   Decimal           @default(0.00) @db.Decimal(12, 2)
  billerShare       Decimal           @default(0.00) @db.Decimal(12, 2)
  derashRef         String            @unique @default(cuid())
  rawResponse       Json?
  agent             Agent             @relation(fields: [agentId], references: [id])
  bill              Bill              @relation(fields: [billId], references: [id])

  @@index([transactionId])
  @@index([idempotencyKey])
}

model AgentEvent {
  id        String   @id @default(uuid())
  agentId   String?
  userId    String?
  action    String
  createdAt DateTime @default(now())
  payload   Json?
  processed Boolean  @default(false)
  agent     Agent?   @relation(fields: [agentId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  action     String
  entityName String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  status     String   @default("SUCCESS")
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entityName, entityId])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  EXPIRED
  CANCELLED
}

enum TransactionStatus {
  INITIATED
  SUCCESSFUL
  FAILED
  EXPIRED
  CANCELLED
  REVERSED
  TIMEOUT
  PENDING
}

enum PaymentMethod {
  CASH
  MOBILE_APP
  USSD
  WEB
  ATM
  WALLET
  BANK_TRANSFER
  CARD
}

enum UserRole {
  SYSTEM_ADMIN
  BILLER_USER
  AGENT_USER
  SUPER_ADMIN
  BILLER_ADMIN
}
