generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
  EXPIRED
}

enum TransactionStatus {
  INITIATED
  SUCCESSFUL
  FAILED
  EXPIRED
  CANCELLED
  REVERSED
  TIMEOUT
}

enum PaymentMethod {
  CASH
  MOBILE_APP
  BANK_TRANSFER
  USSD
  CARD
  WEB
  ATM
  WALLET
}
 enum UserRole {
  SUPER_ADMIN    // Derash Staff (Full System Control)
  BILLER_ADMIN   // Utility Staff (Manage their own bills/reports)
  AGENT_USER     // Bank Teller (Process payments only)
}

model User {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  email     String   @unique
  password  String   // Hashed password string
  role      UserRole @default(AGENT_USER)
  isActive  Boolean  @default(true)

  // A User can belong to an Agent (Bank) OR a Biller (Utility)
  agent_id  String?
  agent     Agent?   @relation(fields: [agent_id], references: [id])
  
  biller_id String?
  biller    Biller?  @relation(fields: [biller_id], references: [id])
 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Biller {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(100)
  code         String   @unique @db.VarChar(20) // e.g., "AAWSA"
  category     String   @db.VarChar(50)
  allows_partial Boolean  @default(false)
  charges_late_fee Boolean  @default(true)
  grace_period   Int        @default(0)    // Days after due date before penalties apply
  account_no   String   @db.VarChar(50) 
  apiEndPoint  String?  
  isActive     Boolean  @default(true)
  bills        Bill[]
  users        User[]   // Staff members for this biller
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([code])
}

model Customer {
  id              String   @id @default(uuid())
  full_name       String   @db.VarChar(100)
  email           String?  @unique
  phone_no        String   @unique @db.VarChar(15)
  isActive        Boolean  @default(true)
  bills           Bill[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([phone_no])
}


model Agent {
  id           String        @id @default(uuid())
  name         String        @db.VarChar(100)
  code         String        @unique @db.VarChar(20) // e.g., "CBE", "TELEBIRR"
  api_key      String?       @unique 
  isActive     Boolean       @default(true)
  transactions Transaction[]
  users        User[]        // Bank tellers / Staff

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([code])
}

model Bill {
  id               String     @id @default(uuid())
  bill_reference   String     @unique // The Id the customer uses
  amount_due       Decimal    @db.Decimal(12, 2)
  amount_paid      Decimal    @default(0) @db.Decimal(12, 2)
  remaining_bal    Decimal    @db.Decimal(12, 2)
  currency         String     @default("ETB") @db.VarChar(3)
  status           BillStatus @default(UNPAID)   
  due_date         DateTime
  paid_at          DateTime
  period           String       @unique // e.g., "2023-10"
  biller_id        String       @unique
  biller           Biller     @relation(fields: [biller_id], references: [id])
  customer_id      String
  customer         Customer   @relation(fields: [customer_id], references: [id])
  transactions     Transaction[]

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([bill_reference])
 }

model Transaction {
  id                String        @id @default(uuid())
  transactionId     String        @unique
  agentReference    String?       @unique 
  derash_ref        String        @unique @default(cuid()) // Your internal ID
  billerReference   String?           @unique // Reference returned by Biller (Receipt No)
  idempotencyKey    String        @unique 

  amount           Decimal            @db.Decimal(12, 2) 
  biller_share     Decimal            @db.Decimal(12, 2)
  agent_share      Decimal            @db.Decimal(12, 2)
  aggregator_share Decimal            @db.Decimal(12, 2)
  total_amount     Decimal            @db.Decimal(12, 2) // amount + fees
  
  status           TransactionStatus  @default(INITIATED)
  payment_method   PaymentMethod      @default(MOBILE_APP)
  raw_response     Json?             
  payer_phone      String?          
  agent_id         String
  agent            Agent             @relation(fields: [agent_id], references: [id])
  bill_id          String
  bill             Bill              @relation(fields: [bill_id], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([ transactionId ])
  @@index([ idempotencyKey])
}

model AgentEvent {
  id          String   @id @default(uuid())
  agent_code  String
  payload     Json
  processed   Boolean  @default(false)
  error       String?
  createdAt   DateTime @default(now())
}
 model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  // The dashboard user (admin/staff) who performed the action
  userEmail   String?  // Optional: for easier reading without a join
  action      String   // e.g., "CREATE", "UPDATE", "DELETE", "FORCE_PAY", "REVERSE"
  entityName  String   // e.g., "Biller", "Transaction", "Agent"
  entityId    String   // The ID of the record that was changed
  
  // Storing the "Before" and "After" state as JSON
  oldValues   Json?    
  newValues   Json?    
  
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime @default(now())

  @@index([entityName, entityId])
  @@index([userId])
}

